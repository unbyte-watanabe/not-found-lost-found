APP_NAME="PEP落とし物管理"
APP_ENV=production
APP_KEY=                          # php artisan key:generate
APP_DEBUG=false
APP_URL=https://your-alb-domain.example.com

APP_LOCALE=ja

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=errorlog
LOG_LEVEL=error

# ─── Aurora MySQL ─────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=your-aurora-endpoint.rds.amazonaws.com
DB_PORT=3306
DB_DATABASE=pep_lostfound
DB_USERNAME=pep_user
DB_PASSWORD=
DB_SSL_CA=/etc/ssl/certs/rds-combined-ca-bundle.pem

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true

FILESYSTEM_DISK=s3
QUEUE_CONNECTION=database
CACHE_STORE=database

# ─── AWS ──────────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-northeast-1
AWS_BUCKET=pep-lostfound-assets
UPLOAD_DISK=s3

# ─── SES ──────────────────────────────────────────────────────────────────────
MAIL_MAILER=ses
MAIL_FROM_ADDRESS="noreply@pep.example.com"
MAIL_FROM_NAME="PEP落とし物管理"

# ─── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=
